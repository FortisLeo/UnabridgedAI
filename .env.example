# Copy to .env
ZERO_ZERO_API_KEY=your_0_0_api_key
# Optional. Comma-separated values enable simple upstream rotation.
# ZERO_ZERO_API_KEYS=key_one,key_two

# Optional. Enables Exa-backed web search. Without it, DuckDuckGo HTML search is used.
EXA_API_KEY=

PORT=3001
DB_PATH=./unabridged.db
NODE_ENV=development

# Cookies. Leave unset: Secure only on HTTPS hostnames, never on raw IPs.
# Set 0 for HTTP IP deploys if a proxy lies about https.
# COOKIE_SECURE=0

# Crypto invoices. Leave the xpub unset and invoice creation returns 503.
# Account xpub at m/44'/60'/0'. Never put an xprv, mnemonic, or spend key here.
# EVM_ACCOUNT_XPUB=
# ETHEREUM_RPC_URLS=https://primary.example,https://backup.example
# POLYGON_RPC_URLS=https://primary.example,https://backup.example
# SOLANA_RPC_URLS=https://primary.example,https://backup.example
# Comma-separated pre-derived Solana owner pubkeys, ordered by invoice index.
# Keep the Solana seed offline; never configure it in this service.
# SOLANA_OWNER_PUBKEYS=
# MONERO_WALLET_RPC_URL=http://127.0.0.1:18088/json_rpc
# MONERO_WALLET_RPC_USER=
# MONERO_WALLET_RPC_PASSWORD=
# PAYMENT_WATCH_MS=15000
# Operator price. Integer cents for stablecoins, atomic units for XMR.
# Set with the operator CLI, not by guessing a default.
# PRO_PRICE_CENTS=
# XMR_ATOMIC_UNITS=
